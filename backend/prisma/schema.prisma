generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                  Int       @id @default(autoincrement())
  email               String    @unique @db.VarChar(255)
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  name                String?   @db.VarChar(255)
  role                String    @default("viewer") @db.VarChar(50)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  totpSecret          String?   @map("totp_secret") @db.VarChar(255)
  totpEnabled         Boolean   @default(false) @map("totp_enabled")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  sessions UserSession[]

  @@map("users")
}

/** Active login sessions — used for online status and force-logout. */
model UserSession {
  id         String    @id @db.VarChar(36)
  userId     Int       @map("user_id")
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.VarChar(512)
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt], map: "idx_session_user_revoked")
  @@index([lastSeenAt], map: "idx_session_last_seen")
  @@map("user_sessions")
}

/** Security audit trail (failed logins, force-logout, 2FA, etc.). */
model SecurityAuditLog {
  id        Int      @id @default(autoincrement())
  event     String   @db.VarChar(64)
  userId    Int?     @map("user_id")
  email     String?  @db.VarChar(255)
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  detail    String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt], map: "idx_audit_created")
  @@index([event, createdAt], map: "idx_audit_event_created")
  @@map("security_audit_logs")
}

model ReportDataset {
  id         Int      @id @default(autoincrement())
  marketId   String   @map("market_id") @db.VarChar(100)
  week       String   @db.VarChar(32)
  tabId      String   @map("tab_id") @db.VarChar(64)
  category   String   @default("") @db.VarChar(64)
  columns    Json
  rows       Json
  fileName   String?  @map("file_name") @db.VarChar(255)
  sheetName  String?  @map("sheet_name") @db.VarChar(255)
  location   String?  @db.VarChar(255)
  uploadedBy Int?     @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([marketId, week, tabId, category], map: "uniq_market_week_tab_category")
  @@index([marketId, week], map: "idx_market_week")
  @@map("report_datasets")
}

/** Audit snapshot of a save/import/restore (who + IP + when). */
model ReportHistory {
  id        Int      @id @default(autoincrement())
  marketId  String   @map("market_id") @db.VarChar(100)
  action    String   @db.VarChar(64)
  label     String   @db.VarChar(512)
  weeks     String   @db.Text
  fileName  String?  @map("file_name") @db.VarChar(255)
  userId    Int?     @map("user_id")
  userEmail String?  @map("user_email") @db.VarChar(255)
  userName  String?  @map("user_name") @db.VarChar(255)
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  itemCount Int      @default(0) @map("item_count")
  createdAt DateTime @default(now()) @map("created_at")

  items ReportHistoryItem[]

  @@index([marketId, createdAt], map: "idx_history_market_created")
  @@map("report_histories")
}

model ReportHistoryItem {
  id         Int    @id @default(autoincrement())
  historyId  Int    @map("history_id")
  week       String @db.VarChar(32)
  tabId      String @map("tab_id") @db.VarChar(64)
  category   String @default("") @db.VarChar(64)
  columns    Json
  rows       Json
  fileName   String? @map("file_name") @db.VarChar(255)
  sheetName  String? @map("sheet_name") @db.VarChar(255)
  location   String? @db.VarChar(255)

  history ReportHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)

  @@index([historyId], map: "idx_history_item_history")
  @@map("report_history_items")
}

/** Point-in-time snapshot of one market's report datasets. */
model ReportBackup {
  id        Int      @id @default(autoincrement())
  marketId  String   @map("market_id") @db.VarChar(100)
  label     String   @db.VarChar(512)
  trigger   String   @default("manual") @db.VarChar(32)
  itemCount Int      @default(0) @map("item_count")
  rowCount  Int      @default(0) @map("row_count")
  userId    Int?     @map("user_id")
  userEmail String?  @map("user_email") @db.VarChar(255)
  userName  String?  @map("user_name") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  items ReportBackupItem[]

  @@index([marketId, createdAt], map: "idx_backup_market_created")
  @@map("report_backups")
}

model ReportBackupItem {
  id        Int     @id @default(autoincrement())
  backupId  Int     @map("backup_id")
  marketId  String  @map("market_id") @db.VarChar(100)
  week      String  @db.VarChar(32)
  tabId     String  @map("tab_id") @db.VarChar(64)
  category  String  @default("") @db.VarChar(64)
  columns   Json
  rows      Json
  fileName  String? @map("file_name") @db.VarChar(255)
  sheetName String? @map("sheet_name") @db.VarChar(255)
  location  String? @db.VarChar(255)

  backup ReportBackup @relation(fields: [backupId], references: [id], onDelete: Cascade)

  @@index([backupId], map: "idx_backup_item_backup")
  @@map("report_backup_items")
}

/** Simple key/value store for tool configuration (e.g. auto-backup schedule). */
model AppSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
