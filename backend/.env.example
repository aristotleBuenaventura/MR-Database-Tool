PORT=4000
DATABASE_URL="mysql://root:password@localhost:3306/mr_database_tool"
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=password
DATABASE_NAME=mr_database_tool
# Optional. Auto-detected on macOS (/tmp/mysql.sock) and Linux if unset.
# DATABASE_SOCKET=/tmp/mysql.sock
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173
# Secret for wiping report_datasets via URL (not shown in the UI).
# Example: GET http://localhost:4000/api/admin/clear-reports?token=...&confirm=YES
# Leave empty/unset to disable the endpoint (returns 404).
ADMIN_CLEAR_TOKEN=change-me-long-random-clear-token
