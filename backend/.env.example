PORT=4000
DATABASE_URL="mysql://root:password@localhost:3306/mr_database_tool"
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=password
DATABASE_NAME=mr_database_tool
# Optional. Auto-detected on macOS (/tmp/mysql.sock) and Linux if unset.
# DATABASE_SOCKET=/tmp/mysql.sock

# REQUIRED in production: long random secret (32+ chars). Never commit real values.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Frontend origin (cookies + CORS). Must match the browser URL exactly.
CORS_ORIGIN=http://localhost:5173

# Cookie auth (HttpOnly). COOKIE_SECURE=true required behind HTTPS in production.
AUTH_COOKIE_NAME=mr_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Session idle timeout (ms). Default 30 minutes.
SESSION_IDLE_TIMEOUT_MS=1800000

# Login brute-force protection
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=20

# Require authenticator 2FA for these roles (comma-separated)
REQUIRE_2FA_ROLES=admin,superadmin
TOTP_ISSUER=MR Database Tool

# Optional IP allowlist (comma-separated). Empty = allow all.
# ALLOWED_IPS=127.0.0.1,::1

# JSON body size limit (was 50mb; keep enough for Excel imports)
JSON_BODY_LIMIT=25mb

# Secret for wiping report_datasets via URL (not shown in the UI).
# Leave empty/unset to disable the endpoint (returns 404).
ADMIN_CLEAR_TOKEN=change-me-long-random-clear-token

# Set NODE_ENV=production in production to enable HSTS and secure defaults.
# NODE_ENV=production
